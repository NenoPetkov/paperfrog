TRADING_MODE=paper
STRATEGY_PROFILE=simple
SIMPLE_SCAN_LIMIT=100
SIMPLE_SELECTED_COUNT=2
# Concurrent positions: 1–4; default 2. Aggregate risk and exposure caps still apply.
MAX_CONCURRENT_STRATEGY_TRADES=2
# Daily entries: 0–40 per UTC day; default 12.
MAX_STRATEGY_ENTRIES_PER_DAY=12
# Entries per symbol per UTC day: 1–4; default 2.
MAX_ENTRIES_PER_SYMBOL_PER_DAY=2
SIMPLE_POLL_SECONDS=5
# Supported entry candles: 1m, 5m, 8m, 15m (short intervals require trend mode).
SIMPLE_ENTRY_TIMEFRAME=1m
# Reviews: 1, 5, 8, 15 minutes; 8m entries/reviews must be paired.
SIMPLE_AI_REVIEW_MINUTES=1
SIMPLE_ENTRY_MODE=trend
SIMPLE_ENTRY_PROFILE=standard
# strict requires BTC alignment; neutral_allowed accepts neutral but never opposing BTC.
SIMPLE_BTC_REFERENCE_ENABLED=true
SIMPLE_BTC_DIRECTION_POLICY=strict
# Coin day trend plus liquid-pool breadth, BTC/ETH day trend veto new entries.
SIMPLE_MARKET_TREND_ENABLED=true
SIMPLE_MAX_HOLD_HOURS=4
# Opt-in margin sizing and shorter cooldown are bundled in larger-positions.yaml.
SIMPLE_SIZING_MODE=risk
# Optional 10–50% margin policy: equity_range, with SIMPLE_POSITION_MARGIN_CAP=0.5.
# That policy removes quote participation limits and uses a fee-reserved low-funds fallback.
SIMPLE_POSITION_MARGIN_CAP=0.8
SIMPLE_TOTAL_MARGIN_CAP=1.0
SOFT_LOSS_COOLDOWN_MINUTES=720
# Account defaults; larger-positions.yaml opts into 10x account thresholds.
DAILY_LOSS_LIMIT=0.0125
WEEKLY_LOSS_LIMIT=0.035
HIGH_WATER_DRAWDOWN=0.06
PROFIT_GUARD_SCALE=1
FUTURES_ACCOUNT_MODE=isolated
MARGIN_TYPE=ISOLATED
SIMPLE_LIVE_RESEARCH_WAIVER=false
BINANCE_ENV=testnet
LIVE_TRADING_ENABLED=false
I_UNDERSTAND_LIVE_RISK=
BINANCE_API_KEY=
BINANCE_API_SECRET=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=[]
TELEGRAM_ALLOWED_CHAT_IDS=[]
OPENAI_PRIMARY_MODEL=gpt-6-luna
OPENAI_ESCALATION_MODEL=gpt-6.1-sol
